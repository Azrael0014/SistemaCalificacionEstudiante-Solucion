@{
    ViewData["Title"] = "Lista de Materias";
}

<div class="container my-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Crear Nueva Materia
            </a>
        </div>
    </div>

    <div class="card shadow-sm p-3">
        <table id="materiasTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre de la Materia</th>
                    <th>Créditos</th>
                    <th>Profesor</th>
                    <th style="width:120px;">Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#materiasTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json"
                },
                "ajax": {
                    "url": "/Materias/GetAll",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "codigoMateria", "autoWidth": true },
                    { "data": "nombre", "autoWidth": true },
                    { "data": "creditos", "autoWidth": true },
                    { "data": "profesorAsignado", "autoWidth": true },
                    {
                        "data": "id",
                        "render": function (data) {
                            return `
                                <div class="text-center">
                                    <a href="/Materias/Edit/${data}" class='btn btn-success btn-sm mx-1' title="Editar"><i class="fas fa-edit"></i></a>
                                    <a href="/Materias/Delete/${data}" class='btn btn-danger btn-sm mx-1' title="Borrar"><i class="fas fa-trash"></i></a>
                                </div>
                            `;
                        },
                        "orderable": false,
                        "searchable": false
                    }
                ]
            });
        });
    </script>
}