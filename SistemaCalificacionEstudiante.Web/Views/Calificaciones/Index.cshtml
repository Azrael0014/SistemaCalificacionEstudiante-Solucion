@{
    ViewData["Title"] = "Registro de Calificaciones";
}

<div class="container my-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Registrar Calificación
            </a>
        </div>
    </div>

    <div class="card shadow-sm p-3">
        <table id="calificacionesTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th>Materia</th>
                    <th>Nota Final</th>
                    <th>Clasificación</th>
                    <th>Estado</th>
                    <th style="width:120px;">Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#calificacionesTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.11.5/i18n/es-ES.json"
                },
                "ajax": {
                    "url": "/Calificaciones/GetAll",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "estudiante.fullName" },
                    { "data": "materia.nombre" },
                    {
                        "data": "totalCalificacion",
                        "render": function(data) { return data.toFixed(2); }
                    },
                    { "data": "clasificacion" },
                    {
                        "data": "estado",
                        "render": function(data) {
                            return data === "Aprobado"
                                ? `<span class="badge bg-success">${data}</span>`
                                : `<span class="badge bg-danger">${data}</span>`;
                        }
                    },
                    {
                        "data": "id",
                        "render": function (data) {
                            return `
                                <div class="text-center">
                                    <a href="/Calificaciones/Edit/${data}" class='btn btn-success btn-sm mx-1' title="Editar"><i class="fas fa-edit"></i></a>
                                    <a href="/Calificaciones/Delete/${data}" class='btn btn-danger btn-sm mx-1' title="Borrar"><i class="fas fa-trash"></i></a>
                                </div>
                            `;
                        },
                        "orderable": false,
                        "searchable": false
                    }
                ]
            });
        });
    </script>
}