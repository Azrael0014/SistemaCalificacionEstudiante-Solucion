@model SistemaCalificacionEstudiante.Domain.Entities.Calificacion

@{
    ViewData["Title"] = "Borrar Calificación";
}

<div class="container my-4">
    <h1>@ViewData["Title"]</h1>
    <h3 class="text-danger">¿Estás seguro de que quieres borrar este registro de calificación?</h3>
    <div class="card shadow-sm p-4 mt-3">
        <h4>Detalles</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Estudiante</dt>
            <dd class="col-sm-9">@Model.Estudiante.FullName</dd>
            <dt class="col-sm-3">Materia</dt>
            <dd class="col-sm-9">@Model.Materia.Nombre</dd>
            <dt class="col-sm-3">Nota Final</dt>
            <dd class="col-sm-9">@Model.TotalCalificacion.ToString("F2")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Borrar Definitivamente" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>